# ==========================================
# SENDFILES - BACKEND CONFIGURATION
# 100% FREE SETUP & PRODUCTION CONFIGURATION
# ==========================================

# Server Environment
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Storage Provider:
# - 'local': 100% Free local container/disk storage (zero setup needed)
# - 'r2': Cloudflare R2 (10 GB free forever, $0 egress fees)
# - 's3' or 'b2': Backblaze B2 (10 GB free forever, S3-compatible, no credit card required)
STORAGE_PROVIDER=local

# Local Storage Directory (Used when STORAGE_PROVIDER=local)
LOCAL_STORAGE_DIR=./data/storage

# SQLite Database File Path
DATABASE_PATH=./data/sendfiles.db

# ----------------------------------------------------
# 100% FREE OBJECT STORAGE: Cloudflare R2 / Backblaze B2
# ----------------------------------------------------
# Option A: Cloudflare R2 (10 GB free forever, $0 bandwidth fees)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=sendfiles-bucket
R2_CUSTOM_DOMAIN=

# Option B: Backblaze B2 or Generic S3 (10 GB free forever, S3-compatible)
# S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# S3_REGION=us-west-004
# S3_BUCKET_NAME=my-sendfiles-b2-bucket
# S3_FORCE_PATH_STYLE=false

# ----------------------------------------------------
# FREE TIER KEEP-ALIVE (Prevents free hosts from sleeping)
# ----------------------------------------------------
# On free hosts like Render or Koyeb that sleep after 15m of inactivity,
# set your live public URL here to ping itself every 14 minutes and stay awake 24/7!
# Example: SELF_PING_URL=https://sendfiles.onrender.com/api/health
SELF_PING_URL=
SELF_PING_INTERVAL_MINUTES=14

# ----------------------------------------------------
# Transfer & File Limits
# ----------------------------------------------------
# Max file size: 5 GB in bytes (5 * 1024 * 1024 * 1024 = 5368709120)
MAX_FILE_SIZE_BYTES=5368709120
# Default transfer expiration in hours (automatic 34 hours)
TRANSFER_EXPIRATION_HOURS=34
# Multipart upload part size in bytes (10 MB = 10485760; S3/R2 requires min 5 MB per part)
MULTIPART_CHUNK_SIZE_BYTES=10485760

# ----------------------------------------------------
# Security Settings
# ----------------------------------------------------
# Rate limit for transfer code guessing: max attempts per window
RATE_LIMIT_CODE_MAX=20
RATE_LIMIT_CODE_WINDOW_MINUTES=15
# Secret salt for hashing sender tokens in database
SECURITY_SECRET=sendfiles-secure-development-salt-change-in-production
